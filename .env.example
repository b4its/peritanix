# ============================================================================
# DAPE / Peritanix — Environment Configuration
# Copy to .env and adjust: `cp .env.example .env`
# ============================================================================

# --- Project ---
COMPOSE_PROJECT_NAME=peritanix
DAPE_ENV=development

# --- PostgreSQL + PostGIS ---
POSTGRES_USER=dape
POSTGRES_PASSWORD=dape_secret
POSTGRES_DB=dape
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-exposed port (avoid clashing with a local postgres on 5432)
POSTGRES_HOST_PORT=55491

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=56438

# --- Object storage (S3/MinIO) ---
# Default dev: filesystem-backed `files` service (minio/minio is registry-restricted
# in some sandboxes). For real S3/MinIO: set MINIO_HOST=minio and run
# `docker compose --profile storage up -d`.
MINIO_ROOT_USER=dape_minio
MINIO_ROOT_PASSWORD=dape_minio_secret
MINIO_HOST=files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_HOST_PORT=59059
MINIO_CONSOLE_HOST_PORT=59060
MINIO_BUCKET_RAW=dape-raw

# --- FastAPI ML/Physics service ---
FASTAPI_HOST=ml
FASTAPI_PORT=8000
FASTAPI_HOST_PORT=58059
FASTAPI_INTERNAL_TOKEN=internal-shared-secret-change-me

# --- Go backend API ---
GO_HOST=api
GO_PORT=8080
GO_HOST_PORT=58139
JWT_SECRET=change-me-in-production-please-32chars-min
JWT_TTL_HOURS=720
# Enforce JWT on mutating routes. Keep false for local dev/scripts.
AUTH_REQUIRED=false

# --- SvelteKit web frontend ---
WEB_PORT=5173
WEB_HOST_PORT=55232
# Public base URL the browser uses to reach the Go API
PUBLIC_API_BASE_URL=http://localhost:58139

# --- DAPE physics constants (overridable) ---
DAPE_TBASE_C=15.0
DAPE_TARGET_CALORIMETRY_C=52.0

# --- DEM source (optional) ---
# Path to an SRTM GeoTIFF tile inside the ML container. When empty the engine
# uses a deterministic synthetic valley DEM (dev/offline default). Mount a real
# tile to /data and set this to e.g. /data/srtm_java.tif for real hydrology.
DAPE_DEM_PATH=
# Host path to Android SDK (mounted into mobile container for mobile-build)
ANDROID_SDK_PATH=/home/xmitsu/Android/Sdk
